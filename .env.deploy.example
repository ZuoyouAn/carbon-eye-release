# Copy to .env.deploy (ignored by Git). Never paste credentials into chat.
# Neon Connect -> Python / SQLAlchemy, prefer pooled connection with SSL.
DATABASE_URL=
# Optional: bootstrap only when there is no administrator. Never upgrades an existing user.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# One-time private setup: rename legacy root to admin, preserving its ID/content.
# Existing active admin is never reset on subsequent restarts. Remove after setup.
ADMIN_SETUP_PASSWORD=
CARBON_EYE_STANDALONE=false
CORS_ORIGINS=https://carbon-eye-sip.netlify.app
SEED_DEMO_DATA=false
